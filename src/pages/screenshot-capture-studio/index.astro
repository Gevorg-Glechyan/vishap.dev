---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProductBar from '../../components/ProductBar.astro';
import Rug from '../../components/Rug.astro';
import { productIcon, logo } from '../../data/brand';
import * as p from '../../data/screenshot';

import editorFullPage from '../../assets/screenshot-capture-studio/editor-full-page.png';
import popup from '../../assets/screenshot-capture-studio/popup.png';
import samplePage from '../../assets/screenshot-capture-studio/sample-page-full.png';
import editor from '../../assets/screenshot-capture-studio/editor.png';
import exportMenu from '../../assets/screenshot-capture-studio/export.png';
import history from '../../assets/screenshot-capture-studio/history.png';

const icon = productIcon[p.slug];
// Captures are taken at double resolution. Offer widths up to the source so high-density screens get every pixel.
const q = 90;
const wide = '(min-width: 1296px) 700px, (min-width: 900px) 58vw, 100vw';
const half = '(min-width: 1296px) 580px, (min-width: 800px) 48vw, 100vw';
const freeFeatures = p.features.filter((f) => f.free);
const premiumFeatures = p.features.filter((f) => !f.free);
---
<Base
  title="Full-page screenshots for Chrome | Screenshot Capture Studio"
  description="Capture full-page screenshots in Chrome, annotate the details, and export PNG, JPEG, WebP, or PDF locally with Screenshot Capture Studio."
  accent={p.accent}
  accentText={p.accentText}
  icon={icon}
>
  <ProductBar
    slot="bar"
    name={p.name}
    icon={icon}
    home={`/${p.slug}/`}
    store={p.store}
    links={[
      { label: 'Capture', href: '#capture' },
      { label: 'Edit', href: '#edit' },
      { label: 'Premium', href: '#premium' },
      { label: 'Pricing', href: '#pricing' },
      { label: 'Questions', href: '#questions' },
      { label: 'Help', href: p.links.support },
    ]}
  />

  <main>
    <!-- 1. Hero -->
    <div class="wrap">
      <header class="hero">
        <span class="label eyebrow">Chrome extension</span>
        <h1 class="display" style="max-width: 13ch">Capture the page. Point to the detail.</h1>
        <p class="lead">Capture a full page, the visible area, or a selected region. Add arrows, text and shapes, crop, or blur, then copy the edited PNG or export PNG, JPEG, WebP, or PDF on your device.</p>
        <div class="actions">
          <a class="btn" href={p.store}>Add to Chrome</a>
          <a class="btn secondary" href="#pricing">See pricing</a>
        </div>
        <p class="mono" style="margin-top: var(--space-4)">Free to start · Chrome on desktop · 33 languages</p>
      </header>

      <Rug>
        <div class="stage">
          <span class="frame"><Image src={editorFullPage} alt="The editor showing a whole web page captured from top to bottom as one image" widths={[800, 1280, 1920, 2560]} sizes="(min-width: 1296px) 1070px, 90vw" quality={q} loading="eager" /></span>
          <span class="inset"><Image src={popup} alt="The toolbar popup listing the capture modes: visible area, selected area, HTML element, full page and bulk capture" widths={[390, 780]} sizes="320px" quality={q} loading="eager" /></span>
        </div>
      </Rug>

      <dl class="facts">
        <div><dt class="label">Capture modes</dt><dd>Visible area · Selected area · Full page</dd></div>
        <div><dt class="label">Export</dt><dd>PNG · JPEG · WebP · PDF</dd></div>
        <div><dt class="label">Processing</dt><dd>On your device</dd></div>
      </dl>
    </div>

    <!-- 2. Capture -->
    <section class="section wrap" id="capture">
      <div class="split">
        <div>
          <span class="label eyebrow">Capture</span>
          <h2 class="title">Take the part you need.</h2>
          <ul class="diamonds">
            {p.captureModes.map((m) => <li><strong>{m.name}</strong><span>{m.text}</span></li>)}
          </ul>
        </div>
        <Rug field="teal" caption="The toolbar popup, and a full page captured as one image. Fictional sample content.">
          <div class="duo">
            <span class="frame"><Image src={popup} alt="The toolbar popup with its capture modes" widths={[390, 780]} sizes="(min-width: 900px) 300px, 50vw" quality={q} /></span>
            <span class="frame tall"><Image src={samplePage} alt="A long sample page captured from top to bottom as a single image" widths={[480, 960]} sizes="(min-width: 900px) 240px, 40vw" quality={q} /></span>
          </div>
        </Rug>
      </div>
    </section>

    <!-- 3. Edit -->
    <section class="section wrap" id="edit">
      <div class="split flip">
        <div>
          <span class="label eyebrow">Edit</span>
          <h2 class="title">Mark it up before it leaves.</h2>
          <p class="lead">Point with arrows, write a note, box the thing that matters. Crop keeps the original underneath, so nothing is lost.</p>
          <div class="tools">
            {p.tools.map((t) => <span class="tag label">{t}</span>)}
          </div>
          <p class="small" style="margin-top: var(--space-6)">Blur hides detail on screen. It is not a guarantee of secure redaction.</p>
        </div>
        <Rug caption="An arrow, a rectangle, a text note and a blurred value on a captured area. Fictional sample content.">
          <span class="frame crop"><Image src={editor} alt="The editor showing an arrow, a rectangle, a text note and a blurred value on a captured area" widths={[960, 1440, 1920, 2560]} sizes={wide} quality={q} /></span>
        </Rug>
      </div>
    </section>

    <!-- 4. Export and History -->
    <section class="section wrap" id="export">
      <div class="section-head">
        <span class="label eyebrow">Export and History</span>
        <h2 class="title">Send it on, or come back to it.</h2>
      </div>
      <div class="pair">
        <div>
          <Rug field="teal">
            <span class="frame crop right"><Image src={exportMenu} alt="The download menu offering PNG, JPEG, WebP and PDF" widths={[960, 1440, 1920, 2560]} sizes={half} quality={q} /></span>
          </Rug>
          <h3>Four formats, saved on your computer</h3>
          <p class="small">Copy the edited PNG to the clipboard, or download PNG, JPEG, WebP or PDF. Files go to a Screenshot Capture Studio folder in Downloads, or a folder you choose.</p>
        </div>
        <div>
          <Rug>
            <span class="frame crop"><Image src={history} alt="Capture history listing two saved captures with their modes and dates" widths={[960, 1440, 2200]} sizes={half} quality={q} /></span>
          </Rug>
          <h3>History that stays on this device</h3>
          <p class="small">Reopen a capture with its edits, rename it, pin it or delete it. History keeps up to 100 items or 250 MB. There is no account and no sync.</p>
        </div>
      </div>
    </section>

    <!-- 5. Premium workflows -->
    <section class="section wrap" id="premium">
      <div class="split">
        <div>
          <span class="label eyebrow">Premium</span>
          <h2 class="title">Premium adds the heavier jobs.</h2>
          <p class="lead">Everything above is free. Premium is for capturing in bulk and for handing a screenshot straight to the place you work.</p>
          <div class="actions"><a class="btn secondary" href="#pricing">Compare Free and Premium</a></div>
        </div>
        <div class="cards">
          {premiumFeatures.map((f) => (
            <div class="card">
              <span class="tag label premium">Premium</span>
              <h3>{f.name}</h3>
              <p class="small">{f.detail}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. What stays, what leaves -->
    <section class="section wrap" id="privacy">
      <div class="section-head">
        <span class="label eyebrow">Your data</span>
        <h2 class="title" style="max-width: 22ch">What stays on your device, and what leaves it.</h2>
      </div>
      <div class="ledger">
        <div>
          <h3>Stays on your device</h3>
          <ul class="diamonds">
            {p.stays.map((s) => <li><strong>{s}</strong></li>)}
          </ul>
        </div>
        <div>
          <h3>Leaves your device</h3>
          <ul class="diamonds">
            {p.leaves.map((l) => <li><strong>{l.what}</strong><span>{l.detail}</span></li>)}
          </ul>
        </div>
      </div>
      <p class="small" style="margin-top: var(--space-6)"><a class="text-link" href={p.links.privacy}>Read the privacy policy</a></p>
    </section>

    <!-- 7. Pricing -->
    <section class="section wrap" id="pricing">
      <div class="section-head">
        <span class="label eyebrow">Pricing</span>
        <h2 class="title">Free to start. Premium when you need it.</h2>
      </div>
      <div class="plans">
        <div class="plan">
          <h3>Free</h3>
          <p class="price">$0 <small>forever</small></p>
          <ul class="diamonds">
            {freeFeatures.map((f) => <li><strong>{f.name}</strong></li>)}
          </ul>
          <div class="actions"><a class="btn" href={p.store}>Add to Chrome</a></div>
        </div>
        <div class="plan featured">
          <h3>Premium</h3>
          <p class="price">{p.price.monthly} <small>a month, or {p.price.yearly} a year</small></p>
          <ul class="diamonds">
            <li><strong>Everything in Free</strong></li>
            {premiumFeatures.map((f) => <li><strong>{f.name}</strong></li>)}
          </ul>
          <p class="small" style="margin-top: var(--space-6)">{p.price.trial} Premium starts inside the extension: open Settings, then Premium.</p>
        </div>
      </div>
      <div class="table-wrap">
        <table>
          <caption class="label" style="position: absolute; left: -9999px">Screenshot Capture Studio Free and Premium features</caption>
          <thead><tr><th scope="col">Feature</th><th scope="col">Free</th><th scope="col">Premium</th></tr></thead>
          <tbody>
            {p.features.map((f) => (
              <tr>
                <th scope="row"><strong>{f.name}</strong><span>{f.detail}</span></th>
                <td class={f.free ? 'yes' : 'no'}>{f.free ? 'Included' : 'Not included'}</td>
                <td class="yes">Included</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="small" style="margin-top: var(--space-4)">Taxes may apply and are calculated at checkout.</p>
    </section>

    <!-- 8. Three steps -->
    <section class="section wrap" id="how">
      <div class="section-head">
        <span class="label eyebrow">How to</span>
        <h2 class="title" style="max-width: 20ch">A full-page screenshot in three steps.</h2>
      </div>
      <ol class="steps">
        {p.steps.map((s) => <li>{s}</li>)}
      </ol>
    </section>

    <!-- 9. Questions -->
    <section class="section wrap" id="questions">
      <div class="section-head">
        <span class="label eyebrow">Questions</span>
        <h2 class="title">Asked before installing.</h2>
      </div>
      <div class="faq">
        {p.faqs.map((f, i) => (
          <details id={f.id} open={i === 0}>
            <summary>{f.question}</summary>
            <div class="answer">
              <p>{f.answer}</p>
              <a class="text-link" href={f.link.href}>{f.link.label}</a>
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- 10. Closing band -->
    <section class="section wrap">
      <Rug field="madder">
        <div class="closing">
          <img src={logo['vishap-mark-wool']} alt="" width="160" height="160" />
          <div>
            <h2 class="title">Install Screenshot Capture Studio.</h2>
            <p style="margin-top: var(--space-3)">Free to start. Chrome on desktop.</p>
            <div class="actions"><a class="btn" href={p.store}>Add to Chrome</a></div>
          </div>
        </div>
      </Rug>
    </section>
  </main>

</Base>
