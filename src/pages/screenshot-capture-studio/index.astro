---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProductBar from '../../components/ProductBar.astro';
import Rug from '../../components/Rug.astro';
import { productIcon, logo } from '../../data/brand';
import * as p from '../../data/screenshot';

import editorFullPage from '../../assets/screenshot-capture-studio/editor-full-page.png';
import popup from '../../assets/screenshot-capture-studio/popup.png';
import samplePage from '../../assets/screenshot-capture-studio/sample-page-full.png';
import editor from '../../assets/screenshot-capture-studio/editor.png';
import exportMenu from '../../assets/screenshot-capture-studio/export.png';
import history from '../../assets/screenshot-capture-studio/history.png';

const icon = productIcon[p.slug];
// Captures are taken at double resolution. Offer widths up to the source so high-density screens get every pixel.
const q = 90;
const wide = '(min-width: 1296px) 700px, (min-width: 900px) 58vw, 100vw';
const half = '(min-width: 1296px) 580px, (min-width: 800px) 48vw, 100vw';
const freeFeatures = p.features.filter((f) => f.free);
// A phone cannot install a Chrome extension, so it is offered the link to open on a computer instead.
const mailLink = `mailto:?subject=${encodeURIComponent(p.name)}&body=${encodeURIComponent(p.pageUrl)}`;
---
<Base
  title="Full-page screenshots for Chrome | Screenshot Capture Studio"
  description="Take full-page, visible-area or selected-area screenshots in Chrome. Annotate, then export PNG, JPEG, WebP or PDF on your device. Free, with optional Premium."
  accent={p.accent}
  accentText={p.accentText}
  icon={icon}
>
  <ProductBar
    slot="bar"
    name={p.name}
    icon={icon}
    home={`/${p.slug}/`}
    store={p.store('bar')}
    links={[
      { label: 'Capture', href: '#capture' },
      { label: 'Edit', href: '#edit' },
      { label: 'Premium', href: '#premium' },
      { label: 'Pricing', href: '#pricing' },
      { label: 'Questions', href: '#questions' },
      { label: 'Help', href: p.links.support },
    ]}
  />

  <main>
    <!-- 1. Hero -->
    <div class="wrap">
      <header class="hero">
        <span class="label eyebrow">Chrome extension</span>
        <h1 class="display" style="max-width: 15ch">Screenshot the full page. Point to the detail.</h1>
        <p class="lead">Capture a full page, the visible area or a selected region in Chrome. Add arrows, text, shapes and blur, then copy it or save PNG, JPEG, WebP or PDF. Capture, editor and export are free and run on your device.</p>
        <div class="actions">
          <a class="btn for-pointer" href={p.store('hero')}>Add to Chrome</a>
          <a class="btn for-touch" href={mailLink}>Email this page to yourself</a>
          <a class="btn secondary" href="#pricing">See pricing</a>
        </div>
        <p class="small for-pointer" style="margin-top: var(--space-4)">Free: capture, editor, export and History, with no account. Premium from {p.price.monthly} a month.</p>
        <p class="small for-touch" style="margin-top: var(--space-4)">It runs in Chrome on a computer. Send yourself the link and install it there.</p>
      </header>

      <Rug class="big">
        <div class="stage">
          <span class="frame"><Image src={editorFullPage} alt="The editor showing a whole web page captured from top to bottom as one image" widths={[800, 1280, 1920, 2560]} sizes="(min-width: 1296px) 1070px, 90vw" quality={q} loading="eager" /></span>
          <span class="inset"><Image src={popup} alt="The toolbar popup listing the capture modes: visible area, selected area, HTML element, full page and bulk capture" widths={[390, 780]} sizes="320px" quality={q} loading="eager" /></span>
        </div>
      </Rug>

      <dl class="facts">
        <div><dt class="label">Free capture modes</dt><dd>Visible area · Selected area · Full page</dd></div>
        <div><dt class="label">Export</dt><dd>PNG · JPEG · WebP · PDF</dd></div>
        <div><dt class="label">Processing</dt><dd>On your device</dd></div>
      </dl>
    </div>

    <!-- 2. Capture -->
    <section class="section wrap" id="capture">
      <div class="split">
        <div>
          <span class="label eyebrow">Capture</span>
          <h2 class="title">Capture the full page, the visible area or a selection.</h2>
          <ul class="diamonds">
            {p.captureModes.map((m) => <li><strong>{m.name}</strong><span>{m.text}</span></li>)}
          </ul>
        </div>
        <Rug caption="The toolbar popup, and a full page captured as one image. A crown marks Premium modes. Fictional sample content.">
          <div class="duo">
            <span class="frame"><Image src={popup} alt="The toolbar popup with its capture modes and their shortcut keys" widths={[390, 780]} sizes="(min-width: 900px) 300px, 50vw" quality={q} /></span>
            <span class="frame tall"><Image src={samplePage} alt="A long sample page captured from top to bottom as a single image" widths={[480, 960]} sizes="(min-width: 900px) 240px, 40vw" quality={q} /></span>
          </div>
        </Rug>
      </div>
    </section>

    <!-- 3. Three steps -->
    <section class="section wrap" id="how">
      <div class="section-head">
        <span class="label eyebrow">How to</span>
        <h2 class="title">A full-page screenshot in three steps.</h2>
      </div>
      <ol class="steps">
        {p.steps.map((s) => <li>{s}</li>)}
      </ol>
    </section>

    <!-- 4. Edit -->
    <section class="section wrap" id="edit">
      <div class="split flip">
        <div>
          <span class="label eyebrow">Edit</span>
          <h2 class="title">Annotate the screenshot before you send it.</h2>
          <p class="lead">Point with arrows, write a note, box the thing that matters. Crop keeps the original, so you can change it later.</p>
          <p class="small" style="margin-top: var(--space-6)"><strong>Tools.</strong> {p.tools}</p>
          <p class="small" style="margin-top: var(--space-3)">Blur hides detail on screen. It is not a guarantee of secure redaction.</p>
        </div>
        <Rug caption="An arrow, a rectangle, a text note and a blurred value on a captured area. Fictional sample content.">
          <span class="frame"><Image src={editor} alt="The editor showing an arrow, a rectangle, a text note and a blurred value on a captured area" widths={[960, 1440, 1920, 2560]} sizes={wide} quality={q} /></span>
        </Rug>
      </div>
    </section>

    <!-- 5. Export and History -->
    <section class="section wrap" id="export">
      <div class="section-head">
        <span class="label eyebrow">Export and History</span>
        <h2 class="title">Send it on, or come back to it.</h2>
      </div>
      <div class="pair">
        <div>
          <Rug>
            <span class="frame"><Image src={exportMenu} alt="The editor with its download menu open, offering JPEG, WebP and PDF beside the PNG button" widths={[960, 1440, 1920, 2560]} sizes={half} quality={q} /></span>
          </Rug>
          <h3>Four formats, saved on your computer</h3>
          <p class="small">Copy the edited PNG to the clipboard, or download PNG, JPEG, WebP or PDF. Files go to a Screenshot Capture Studio folder in Downloads, or a folder you choose.</p>
        </div>
        <div>
          <Rug>
            <span class="frame"><Image src={history} alt="Capture history listing two saved captures with their modes and dates" widths={[960, 1440, 2200]} sizes={half} quality={q} /></span>
          </Rug>
          <h3>History that stays on this device</h3>
          <p class="small">Reopen a capture with its edits, rename it, pin it or delete it. History keeps up to 100 items or 250 MB. There is no account and no sync.</p>
        </div>
      </div>
    </section>

    <!-- 6. Premium workflows -->
    <section class="section wrap" id="premium">
      <div class="split top">
        <div>
          <span class="label eyebrow">Premium</span>
          <h2 class="title">Premium: single elements, many tabs, and straight into your tracker.</h2>
          <p class="lead">Everything above is free. Premium is {p.price.monthly} a month or {p.price.yearly} a year, with a 3-day free trial.</p>
        </div>
        <div class="cards">
          {p.premiumCards.map((c) => (
            <div class="card">
              <h3>{c.name}</h3>
              <p class="small">{c.text}</p>
            </div>
          ))}
          <div class="card">
            <h3>{p.price.monthly} a month, or {p.price.yearly} a year</h3>
            <p class="small">{p.price.trial}</p>
            <div class="actions" style="margin-top: var(--space-4)"><a class="btn secondary" href="#pricing">Compare Free and Premium</a></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. What stays, what leaves -->
    <section class="section wrap" id="privacy">
      <div class="section-head">
        <span class="label eyebrow">Your data</span>
        <h2 class="title">What stays on your device, and what leaves it.</h2>
      </div>
      <div class="ledger">
        <div>
          <h3>Stays on your device</h3>
          <ul class="diamonds">
            {p.stays.map((s) => <li><strong>{s}</strong></li>)}
          </ul>
        </div>
        <div>
          <h3>Leaves your device</h3>
          <ul class="diamonds">
            {p.leaves.map((l) => <li><strong>{l.what}</strong><span>{l.detail}</span></li>)}
          </ul>
        </div>
      </div>
      <div class="asks">
        <h3>What Chrome asks for when you install it</h3>
        <dl>
          {p.permissions.map((x) => <div><dt>{x.what}</dt><dd class="small">{x.why}</dd></div>)}
        </dl>
        <p class="small" style="margin-top: var(--space-4)">Access to every site is requested only while a Premium bulk capture runs, and removed afterwards.</p>
      </div>
      <p class="small" style="margin-top: var(--space-6)"><a class="text-link" href={p.links.privacy}>Read the privacy policy</a></p>
    </section>

    <!-- 8. Pricing -->
    <section class="section wrap" id="pricing">
      <div class="section-head">
        <span class="label eyebrow">Pricing</span>
        <h2 class="title">The core is free. Premium is {p.price.monthly} a month.</h2>
      </div>
      <div class="plans">
        <div class="plan">
          <h3>Free</h3>
          <p class="price">$0</p>
          <ul class="diamonds">
            {freeFeatures.map((f) => <li><strong>{f.name}</strong></li>)}
          </ul>
          <div class="actions"><a class="btn" href={p.store('pricing-free')}>Add to Chrome</a></div>
        </div>
        <div class="plan featured">
          <h3>Premium</h3>
          <p class="price">{p.price.monthly} <small>a month</small></p>
          <p class="price">{p.price.yearly} <small>a year, {p.price.saving} less than twelve months paid monthly</small></p>
          <ul class="diamonds">
            <li><strong>Everything in Free</strong></li>
            {p.premiumCards.map((c) => <li><strong>{c.name}</strong></li>)}
          </ul>
          <h3 class="how">How to start</h3>
          <ol>
            {p.premiumSteps.map((s) => <li>{s}</li>)}
          </ol>
          <p class="small" style="margin-top: var(--space-4)">{p.price.trial}</p>
          <div class="actions"><a class="btn" href={p.store('pricing-premium')}>Add to Chrome</a></div>
        </div>
      </div>
      <div class="table-wrap">
        <table>
          <caption class="sr">Screenshot Capture Studio Free and Premium features</caption>
          <thead><tr><th scope="col">Feature</th><th scope="col">Free</th><th scope="col">Premium</th></tr></thead>
          <tbody>
            {p.features.map((f) => (
              <tr>
                <th scope="row">{f.name}</th>
                <td><span class:list={['mark', !f.free && 'no']}></span><span class="sr">{f.free ? 'Included' : 'Not included'}</span></td>
                <td><span class="mark"></span><span class="sr">Included</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="small" style="margin-top: var(--space-4)">Taxes may apply and are calculated at checkout.</p>
    </section>

    <!-- 9. Questions -->
    <section class="section wrap" id="questions">
      <div class="section-head">
        <span class="label eyebrow">Questions</span>
        <h2 class="title">Asked before installing.</h2>
      </div>
      <div class="faq">
        {p.faqs.map((f, i) => (
          <details id={f.id} open={i === 0}>
            <summary>{f.question}</summary>
            <div class="answer">
              <p>{f.answer}</p>
              <a class="text-link" href={f.link.href}>{f.link.label}</a>
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- 10. Closing band -->
    <section class="section wrap">
      <Rug field="madder" class="big">
        <div class="closing">
          <img src={logo['vishap-mark-wool']} alt="" width="160" height="160" />
          <div>
            <h2 class="title">Capture your first full page.</h2>
            <p style="margin-top: var(--space-3)">Free. Chrome on desktop. By vishap.</p>
            <div class="actions"><a class="btn" href={p.store('closing')}>Add to Chrome</a></div>
          </div>
        </div>
      </Rug>
    </section>
  </main>
</Base>
