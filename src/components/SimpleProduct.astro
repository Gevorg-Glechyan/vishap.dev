---
// The earlier one-page product layout, carried over unchanged for tools that have not been redesigned yet.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { productIcon, illustration } from '../data/brand';

interface Props {
  slug: string;
  name: string;
  line: string;
  accent: string;
  version: string;
  store: string;
  privacy: string;
  note?: string;
  shot: ImageMetadata;
  shotAlt: string;
  features: { title: string; text: string }[];
}
const { slug, name, line, accent, version, store, privacy, note, shot, shotAlt, features } = Astro.props;
---
<Base title={`${name} · vishap`} description={line} accent={accent} icon={productIcon[slug]}>
  <div class="wrap">
    <header class="product-hero">
      <div>
        <img class="icon" src={productIcon[slug]} alt="" width="64" height="64" />
        <h1>{name}</h1>
        <p class="lead">{line}</p>
        <div class="actions">
          <a class="btn" href={store}>Add to Chrome</a>
          <a class="btn secondary" href="#features">See what it does</a>
        </div>
        <p class="mono">v{version} · Chrome extension · by vishap</p>
        {note && <p class="small" style="margin-top: var(--space-4)">{note}</p>}
      </div>
      <img class="picture" src={illustration[`product-${slug}`]} alt="" width="320" height="320" />
    </header>

    <div class="shot"><Image src={shot} alt={shotAlt} widths={[640, 960, 1280]} sizes="(min-width: 1296px) 1200px, 100vw" /></div>

    <main>
      <section class="section" id="features">
        <h2>What it does</h2>
        <div class="points plain">
          {features.map((f) => <div class="point"><h3>{f.title}</h3><p class="small">{f.text}</p></div>)}
        </div>
      </section>

      <section class="section">
        <h2>Details</h2>
        <dl class="specs">
          <div><dt class="label">Platform</dt><dd>Chrome extension</dd></div>
          <div><dt class="label">Version</dt><dd>{version}</dd></div>
          <div><dt class="label">Privacy</dt><dd><a href={privacy}>Privacy policy</a></dd></div>
        </dl>
      </section>
    </main>
  </div>
</Base>
